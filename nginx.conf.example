# ==============================================================================
# Nginx Configuration Example - Sistema de Reservas Municipalidad
# Producción: Blindaje de Seguridad, Reverse Proxy, OWASP y Hardening
# ==============================================================================

# Definición de límites de tasa a nivel de red (DDoS / Fuerza Bruta)
limit_req_zone $binary_remote_addr zone=api_rate_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=login_rate_limit:10m rate=5r/m;

server {
    listen 80;
    server_name reservas.municipalidad.gob.ar;

    # Redirección obligatoria HTTP -> HTTPS en producción
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name reservas.municipalidad.gob.ar;

    # Certificados SSL / TLS
    ssl_certificate /etc/letsencrypt/live/reservas.municipalidad.gob.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reservas.municipalidad.gob.ar/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Ocultar versión exacta de Nginx (Hardening)
    server_tokens off;

    # Límite máximo de payload para prevenir ataques de agotamiento de memoria
    client_max_body_size 10M;

    # --------------------------------------------------------------------------
    # Cabeceras de Seguridad Globales (OWASP Hardening)
    # --------------------------------------------------------------------------
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # --------------------------------------------------------------------------
    # 1. BLOQUEO ESTRICTO DE ARCHIVOS SENSIBLES (.env, .git, archivos ocultos)
    # --------------------------------------------------------------------------
    location ~* /\.(env|git|htaccess|htpasswd|svn|DS_Store) {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    # --------------------------------------------------------------------------
    # 2. PROXY INVERSO AL BACKEND API (Node.js / Express)
    # --------------------------------------------------------------------------
    # Endpoint crítico de autenticación con rate limiting estricto anti fuerza bruta
    location /api/auth/login {
        limit_req zone=login_rate_limit burst=3 nodelay;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Cabeceras de proxy inverso para forwarding real de IPs
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts seguros para evitar sockets colgados
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Resto de la API REST
    location /api/ {
        limit_req zone=api_rate_limit burst=20 nodelay;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --------------------------------------------------------------------------
    # 3. FRONTEND (Single Page Application - Angular)
    # --------------------------------------------------------------------------
    location / {
        root /var/www/reservas-frontend/dist/frontend-reservas/browser;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Cache control optimizado para assets estáticos
        location ~* \.(?:css|js|woff2?|svg|gif|png|jpe?g|ico)$ {
            expires 30d;
            add_header Cache-Control "public, no-transform";
        }
    }
}
